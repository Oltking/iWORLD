# KIPR web app env. Copy to .env.local and fill in.
# Privy app ID — PUBLIC client-side identifier (ships in the browser bundle).
# Get one free at https://dashboard.privy.io (create an app, add 0G Galileo as a
# custom chain). Without it, the app still runs in MetaMask-only mode.
VITE_PRIVY_APP_ID=

# Optional: pin a specific 0G Compute TeeML provider address for inference.
# VITE_ZG_COMPUTE_PROVIDER_ADDR=

# Funder service URL (sponsored starter 0G for email users). Defaults to localhost.
# VITE_FUNDER_URL=http://localhost:8787

# Compute relay URL — shared, private, metered TEE chat (approach C). When set, chat
# works for everyone without each user funding their own ~4 0G ledger.
# VITE_COMPUTE_RELAY_URL=http://localhost:8788

# Deployed contracts (Phase 2 + marketplace). When set, Minting Hall + Marketplace
# go live. Already deployed on 0G Galileo testnet (see packages/contracts/README):
# VITE_AGENT_NFT_ADDRESS=0xade8466d4c89940a7a653e15927407d5922433c0
# VITE_AGENT_MARKET_ADDRESS=0x86e7746cBa2C71C832B9904935E56B7aA6b39975
# VITE_TRANSFER_REGISTRY_ADDRESS=0xEBC2ac9286adc42560423703E48B4cE7af64799d
